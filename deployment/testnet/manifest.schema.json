{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Priva reviewed testnet deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "network", "status", "sourceRevision", "launchpadAddress", "verifier", "jettonMinterAddress", "gatewayUrl", "indexerUrl", "tonConnectManifestUrl", "metadataUrl", "codeHashes", "circuit", "dex"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "network": { "const": "testnet" },
    "status": { "const": "reviewed" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "launchpadAddress": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
    "verifier": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "sourceSha256", "launchpadCodeHash"],
          "properties": {
            "mode": { "const": "inlined" },
            "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "launchpadCodeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "address", "codeHash"],
          "properties": {
            "mode": { "const": "standalone" },
            "address": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
            "codeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "jettonMinterAddress": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
    "gatewayUrl": { "type": "string", "pattern": "^https://" },
    "indexerUrl": { "type": "string", "pattern": "^https://" },
    "tonConnectManifestUrl": { "type": "string", "pattern": "^https://" },
    "metadataUrl": { "type": "string", "pattern": "^https://" },
    "codeHashes": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "circuit": { "type": "object", "additionalProperties": false, "required": ["version", "verificationKeyHash"], "properties": { "version": { "const": 1 }, "verificationKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "dex": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "migration", "reason"],
          "properties": {
            "kind": { "const": "none" },
            "migration": { "const": "disabled" },
            "reason": { "const": "fixed-price-testnet-sale" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceRevision", "nativeVaultAddress", "jettonVaultAddress", "poolAddress", "codeHashes"],
          "properties": {
            "kind": { "const": "dedust-v2" },
            "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "nativeVaultAddress": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
            "jettonVaultAddress": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
            "poolAddress": { "type": "string", "pattern": "^(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}$" },
            "codeHashes": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
          }
        }
      ]
    }
  }
}
