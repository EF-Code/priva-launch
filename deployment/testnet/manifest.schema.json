{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Priva reviewed testnet deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "network", "sourceRevision", "launchpadAddress", "verifierAddress", "gatewayUrl", "indexerUrl", "tonConnectManifestUrl", "codeHashes", "circuit"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "network": { "const": "testnet" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "launchpadAddress": { "type": "string", "minLength": 1 },
    "verifierAddress": { "type": "string", "minLength": 1 },
    "gatewayUrl": { "type": "string", "pattern": "^https://" },
    "indexerUrl": { "type": "string", "pattern": "^https://" },
    "tonConnectManifestUrl": { "type": "string", "pattern": "^https://" },
    "codeHashes": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "circuit": { "type": "object", "additionalProperties": false, "required": ["version", "verificationKeyHash"], "properties": { "version": { "const": 1 }, "verificationKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
