{
  "name": "priva",
  "version": "1.0.0",
  "description": "Privacy-preserving fixed-price token launch interface for TON testnet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:testnet": "PRIVA_PAGES_BUILD=1 PRIVA_TESTNET_MANIFEST_PATH=deployment/testnet/reviewed-manifest.json vite build",
    "preview": "vite preview",
    "gateway:local": "node services/local-gateway.mjs",
    "gateway:render": "node services/local-gateway.mjs",
    "gateway:keyring": "node scripts/start-gateway-keyring.mjs",
    "indexer:local": "node services/local-indexer.mjs",
    "indexer:render": "node services/local-indexer.mjs",
    "derive:testnet-commitments": "node scripts/derive-testnet-commitments.mjs",
    "test": "node scripts/run-tests.cjs",
    "test:local-services": "node tests/local-services.test.cjs",
    "test:real-lifecycle": "npm run compile:settlement-minter && ZK_TELE_AUTH_ARTIFACTS_DIR=vendor/zk-tele-auth/artifacts node tests/priva-purchase-lifecycle.test.mjs",
    "test:real-verifier": "acton build priva_purchase_auth_verifier_boundary && node tests/priva-verifier-boundary.test.mjs",
    "test:contracts": "acton test tests/acton --reporter console",
    "compile-contracts": "node scripts/compile-contracts.cjs",
    "compile:settlement-minter": "node scripts/compile-settlement-minter.cjs",
    "check:release": "node scripts/check-release-readiness.cjs",
    "check:testnet-manifest": "node scripts/check-testnet-manifest.cjs",
    "check:testnet-endpoints": "node scripts/check-testnet-endpoints.mjs",
    "check:testnet-deployments": "node scripts/check-testnet-deployments.mjs",
    "check:testnet-init": "node scripts/check-testnet-init-manifest.cjs",
    "check:testnet-signatures": "node scripts/check-signed-testnet-release.cjs",
    "create:testnet-payload": "node scripts/create-testnet-release-payload.cjs",
    "compile:testnet-init": "node scripts/compile-testnet-init.cjs",
    "create:testnet-minter-init": "node scripts/create-testnet-minter-init.mjs",
    "deploy:testnet-launchpad": "acton script scripts/deploy_testnet_launchpad.tolk",
    "deploy:testnet-minter": "acton script scripts/deploy_testnet_settlement_minter.tolk",
    "handoff:testnet-minter": "acton script scripts/handoff_testnet_settlement_minter.tolk",
    "tonconnect:cert": "node scripts/setup-tonconnect-dev-cert.mjs",
    "tonconnect:relay": "node scripts/tonconnect-https-relay.mjs",
    "tonconnect:probe": "acton script scripts/tonconnect_probe.tolk"
  },
  "keywords": [
    "ton",
    "the-open-network",
    "launchpad",
    "zero-knowledge",
    "zk-tele-auth",
    "privacy",
    "tolk"
  ],
  "author": "ef-code",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@tonconnect/ui": "^3.0.2",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "vite": "^5.2.0"
  }
}
